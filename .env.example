# ==============================================================================
# The Book Club - Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` for local development or configure these variables
# in your hosting provider's dashboard (Cloudflare Pages / Vercel).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Authentication Configuration
# ------------------------------------------------------------------------------
# Primary HMAC-SHA256 session token signing secret (minimum 32 characters)
AUTH_SECRET=dev-auth-secret-min-32-chars-bookclub-session-key

# Auth Provider Mode: "local" (default passwordless/session auth), "clerk", or "kinde"
AUTH_PROVIDER=local

# Optional: Clerk Authentication Keys (when AUTH_PROVIDER=clerk)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Optional: Kinde Authentication Keys (when AUTH_PROVIDER=kinde)
KINDE_CLIENT_ID=
KINDE_CLIENT_SECRET=
KINDE_ISSUER_URL=
KINDE_SITE_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. Database Configuration (Zero-Cost: Turso libSQL or Neon PostgreSQL)
# ------------------------------------------------------------------------------
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# ------------------------------------------------------------------------------
# 3. Cloudflare R2 Object Storage (Zero-Cost PDF Document Storage)
# ------------------------------------------------------------------------------
# Cloudflare Account ID from Cloudflare Dashboard > Overview
R2_ACCOUNT_ID=

# Cloudflare R2 API Token credentials (with Object Read & Write permissions)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Target Cloudflare R2 bucket name
R2_BUCKET_NAME=the-book-club-pdfs

# Optional custom R2 endpoint or public CDN URL
R2_ENDPOINT=
R2_PUBLIC_URL=

# ------------------------------------------------------------------------------
# 4. Storage Purge Cron Authorization
# ------------------------------------------------------------------------------
# Secret authorization token for triggering the hourly PDF purge endpoint (/api/cron/purge)
CRON_SECRET=dev-cron-purge-secret-token-key
