# Copy this file to .env for local development or configure these variables
# in your hosting provider dashboard (Vercel / Cloudflare Pages).

# ------------------------------------------------------------------------------
# 1. Authentication
# ------------------------------------------------------------------------------
# Session signing secret (minimum 32 characters)
AUTH_SECRET=dev-auth-secret-min-32-chars-bookclub-session-key

# Auth provider mode: "local" (default passwordless session), "clerk", or "kinde"
AUTH_PROVIDER=local

# Clerk authentication (required when AUTH_PROVIDER=clerk)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Kinde authentication (required when AUTH_PROVIDER=kinde)
KINDE_CLIENT_ID=
KINDE_CLIENT_SECRET=
KINDE_ISSUER_URL=
KINDE_SITE_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. Database
# ------------------------------------------------------------------------------
# Database connection URL (e.g., libsql://... for Turso or postgres://... for Postgres)
DATABASE_URL=

# Database authentication token (required for Turso / libSQL cloud connections)
DATABASE_AUTH_TOKEN=

# ------------------------------------------------------------------------------
# 3. Cloudflare R2 Storage (PDF Uploads)
# ------------------------------------------------------------------------------
# Cloudflare Account ID from Cloudflare Dashboard
R2_ACCOUNT_ID=

# Cloudflare R2 API Token credentials (Object Read & Write permissions)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Target Cloudflare R2 bucket name
R2_BUCKET_NAME=the-book-club-pdfs

# Optional custom R2 S3 endpoint (defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com)
R2_ENDPOINT=

# Optional public CDN / custom domain URL for serving PDFs (e.g., https://pub-xxx.r2.dev)
R2_PUBLIC_URL=

# ------------------------------------------------------------------------------
# 4. Scheduled Purge Worker
# ------------------------------------------------------------------------------
# Authorization bearer token for the scheduled purge endpoint (/api/cron/purge)
CRON_SECRET=dev-cron-purge-secret-token-key
